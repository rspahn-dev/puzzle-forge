ANTHROPIC_API_KEY=sk-ant-...

# Optional locally — defaults to a local sqlite file if unset.
# Render sets this automatically from the attached Postgres database.
DATABASE_URL=

SECRET_KEY=dev-secret-change-me

# Google OAuth client (console.cloud.google.com > APIs & Services > Credentials).
# Needs an "Authorized redirect URI" of http://127.0.0.1:5000/auth/callback
# for local dev, and https://<your-render-url>/auth/callback for production.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Encrypts stored per-user API keys. Generate once with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing this key makes every stored user API key permanently undecryptable.
APP_ENCRYPTION_KEY=
